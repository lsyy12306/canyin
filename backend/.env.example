# =============================================================================
# 味禾小馆官网后端 —— 生产环境变量模板
# -----------------------------------------------------------------------------
# 用法：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会入库）。
#   cp .env.example .env
#
# 所有变量均与 app/config.py 中的 Settings 字段一一对应，可被环境变量覆盖。
# =============================================================================

# ---- 数据库连接串 ----
# 本地开发（默认，零依赖）：
# DATABASE_URL=sqlite:///./weihe_dev.db
#
# 生产 PostgreSQL（同步驱动！与本项目同步 SQLAlchemy 一致）：
# postgresql+psycopg://<用户>:<密码>@<主机>:5432/<库名>
# docker-compose 中后端连 db 服务示例：
DATABASE_URL=postgresql+psycopg://weihe:weihe_pass@db:5432/weihe

# ---- JWT 签名密钥（务必修改！）----
# 生产必须用固定强随机串；默认随机串会在容器重启后失效，导致已发 token 全部作废。
# 生成方式：openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# ---- CORS 允许的源（逗号分隔）----
# 填入上线后的官网域名与管理后台域名；本地开发默认含 5173/5174。
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-domain.com,https://admin.your-domain.com

# ---- 文件上传目录 ----
# 容器内路径，docker-compose 已把它挂成数据卷。
UPLOAD_DIR=app/static/uploads

# ---- 默认管理员（users 表为空时自动创建）----
# 上线后请尽快在后台修改密码，或改为强口令。
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123456

# ---- 访问令牌有效期（分钟）----
ACCESS_TOKEN_EXPIRE_MINUTES=1440
